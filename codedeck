#!/usr/bin/env bash
# codedeck — one entrypoint for managing this fork: the bridge container,
# the optional Tor daemon, Android APK builds, and workspace checks.
#
# Everything here just wraps commands already established elsewhere in the
# repo (docker compose, apps/android/docker/build-apk.sh,
# apps/android/scripts/build-apk-local.sh, cargo, pnpm) — this script adds no
# new mechanism, only a short memorable surface over them. Docker is the
# default engine; on a Linux host with no docker binary at all, the commands
# that have a local form fall back to the vendored toolchain
# (scripts/install-toolchain.sh, installed on first use).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Git Bash (MSYS) on Windows rewrites leading-/ arguments as if they were
# Windows paths before docker.exe sees them — breaks `docker exec -w /path`.
# Scoped (not exported globally): doing that also breaks docker cp's HOST-side
# path resolution. No-op on real Linux/macOS. Same fix as build-apk.sh.
dexec() { MSYS_NO_PATHCONV=1 docker exec "$@"; }

# --- Engine selection: Docker when its daemon answers; else (Linux only,
# and only when no docker binary exists at all) the vendored toolchain.
#
# A binary whose daemon is merely DOWN is not "no Docker": that machine chose
# Docker, so it gets "start your daemon" — never a surprise local run (or a
# multi-GB install). bridge and tor wrap docker compose and have no local
# form regardless.

# One probe, three states: 0 = Docker usable; 1 = no docker binary at all;
# 2 = binary present but its daemon does not answer. Every command site acts
# on this single result — with the daemon down, `docker info` itself can hang
# for seconds, so it must never run twice for one command.
docker_state() {
  command -v docker >/dev/null 2>&1 || return 1
  docker info >/dev/null 2>&1 || return 2
}

fail_docker_down() {
  echo "Docker is installed but its daemon is unreachable — start it and re-run." >&2
  exit 1
}

# Commands with no local mode (bridge, tor) call this first.
require_docker() {
  local state=0
  docker_state || state=$?
  case $state in
    0) return 0 ;;
    2) fail_docker_down ;;
  esac
  echo "Docker is not installed, and this command is only a docker compose" >&2
  echo "wrapper — it has no local form. Install Docker and re-run (Docker" >&2
  echo "Desktop on Windows/macOS), or on Linux run the bridge from source:" >&2
  echo "docs/BRIDGE.md, \"Build from source\"." >&2
  exit 1
}

# The local engine: the vendored toolchain from scripts/install-toolchain.sh.
# Installs it on first use so a Docker-less Linux host (or the coding agent
# driving one) gets a working path with zero extra steps; idempotent after
# that. Takes the components the command being run actually needs — `node`
# for the TypeScript workspace, `rust` for the crates, `android` for
# apps/android — and installs only what is missing of those, so a host that
# runs one part of the repo never fetches the others (the Android SDK and NDK
# are a few GB on their own). No argument means the whole toolchain.
# env.sh is sourced into THIS shell so cargo/node/pnpm/java stay on PATH
# for the rest of the script. Non-Linux hosts have no supported Docker-free
# path — scripts/install-toolchain.sh is Linux-only by design.
ensure_toolchain() {
  if [ "$(uname -s)" != Linux ]; then
    echo "Docker is unavailable and this host cannot use the local toolchain" >&2
    echo "instead (scripts/install-toolchain.sh is Linux-only). Install and" >&2
    echo "start Docker (Docker Desktop on Windows/macOS), then re-run this" >&2
    echo "command. See CLAUDE.md, \"Commands\"." >&2
    exit 1
  fi
  local wanted=("$@") missing=()
  [ ${#wanted[@]} -eq 0 ] && wanted=(java rust node android)
  local component
  for component in "${wanted[@]}"; do
    grep -qx "$component" toolchain/.components 2>/dev/null || missing+=("$component")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    if [ ! -f toolchain/env.sh ]; then
      echo "==> No Docker and no ./toolchain yet — installing what this needs:"
      echo "    ${missing[*]} (one-time; Ctrl-C to abort)"
    else
      echo "==> Adding to ./toolchain: ${missing[*]}"
    fi
    bash scripts/install-toolchain.sh "${missing[@]}"
  fi
  # shellcheck source=/dev/null
  . toolchain/env.sh
}

