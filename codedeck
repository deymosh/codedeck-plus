EOF
}

require_running_bridge() {
  if ! docker ps --filter "name=codedeck-bridge" --filter "status=running" --format '{{.Names}}' | grep -q codedeck-bridge; then
    echo "codedeck-bridge is not running — try: ./codedeck bridge up" >&2
    exit 1
  fi
}

cmd_bridge() {
  require_docker
  case "${1:-}" in
    up)
      docker compose up -d --build codedeck-bridge
      ;;
    down)
      docker compose down
      ;;
    restart)
      docker compose build codedeck-bridge
      docker compose up -d codedeck-bridge
      ;;
    build)
      docker compose build codedeck-bridge
      ;;
    logs)
      docker compose logs -f codedeck-bridge
      ;;
    status)
      docker compose ps
      ;;
    pair)
      require_running_bridge
      # The bridge process itself owns bridge.lock (CDX-033) — a second
      # `pair` invocation inside the same container would just fail to
      # acquire it, so this reads the QR the running `run` command already
      # printed (it opens a pairing window on its own whenever nothing's
      # paired) rather than trying to trigger a new one.
      if ! docker compose logs codedeck-bridge 2>&1 | grep -q "Pairing URL"; then
        echo "No pairing QR found in the logs yet. If the window already" >&2
        echo "expired, restart the bridge for a fresh one: ./codedeck bridge restart" >&2
        exit 1
      fi
      # The QR is printed just above its URL line.
      docker compose logs --no-log-prefix codedeck-bridge 2>&1 | grep -B 32 -A 1 "Pairing URL" | tail -34
      ;;
    shell)
      require_running_bridge
      dexec -it codedeck-bridge bash
      ;;
    *)
      echo "usage: $0 bridge {up|down|restart|build|logs|status|pair|shell}" >&2
      exit 1
      ;;
  esac
}

cmd_tor() {
  require_docker
  case "${1:-}" in
    up)
      docker compose --profile tor up -d --build
      echo
      echo "codedeck-tor is up. Point the bridge at it with, in .env:"
      echo "  CODEDECK_TOR_PROXY_URL=socks5h://codedeck-tor:9050"
      echo "then: ./codedeck bridge restart"
      ;;
    down)
      docker compose stop codedeck-tor
      docker compose rm -f codedeck-tor
      ;;
    *)
      echo "usage: $0 tor {up|down}" >&2
      exit 1
      ;;
  esac
}

cmd_apk() {
  # args pass through, e.g. `./codedeck apk --target aarch64-linux-android`
  local state=0
  docker_state || state=$?
  case $state in
    0) exec ./apps/android/docker/build-apk.sh "$@" ;;
    2) fail_docker_down ;;
  esac
  ensure_toolchain rust java android
  # Sources toolchain/env.sh itself when present.
  exec ./apps/android/scripts/build-apk-local.sh "$@"
}

# shellcheck source=scripts/lib/pack-repo.sh
. scripts/lib/pack-repo.sh

# Start a throwaway container that is removed when the script exits, whether
# it succeeds, fails or is interrupted. Extra args go to `docker create`
# (volumes, limits); MSYS path conversion is off so `-v vol:/path` survives.
start_throwaway() {
  local name="$1" image="$2"
  shift 2
  docker rm -f "$name" >/dev/null 2>&1 || true
  MSYS_NO_PATHCONV=1 docker create --name "$name" "$@" "$image" sleep infinity >/dev/null
  docker start "$name" >/dev/null
  # Double-quoted so $name is baked in NOW, as a literal — the trap fires
  # after the calling function has returned (its locals are gone by then), so
  # a single-quoted trap referencing $name would fail under `set -u`.
  trap "docker rm -f '$name' >/dev/null 2>&1 || true" EXIT
}

# The images this script builds for its own containers, one file each, in
# scripts/docker — beside the scripts that use them rather than at the repo
# root, and needing nothing from the repo as build context. Docker's layer
# cache makes every run after the first a no-op, so the per-image install cost
# is paid once per machine.
TOOL_IMAGE_DIR=scripts/docker

ensure_tool_image() {
  local tag="$1" file="$2"
  shift 2
  echo "==> Preparing $tag image (cached after the first run)"
  docker build -q -t "$tag" -f "$file" "$TOOL_IMAGE_DIR" "$@" >/dev/null
}

# --- Plumbing for the long-lived containers (dev, android). ---

# Exact-name lookups throughout: Docker's `name=` filter is a regular
# expression matched against every container's name, so `codedeck-dev` would
# also answer for `codedeck-dev-2`.
container_exists() {
  docker ps -a --format '{{.Names}}' | grep -qx "$1"
}

container_running() {
  docker ps --format '{{.Names}}' | grep -qx "$1"
}

# A container this script created carries the label. One without it was made
# by hand — or by an older workflow that kept its own sync scripts — and is
# not trusted to have what the commands below expect of its image, so it is
# replaced once rather than used and puzzled over.
container_is_ours() {
  [ "$(docker inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null)" = "1" ]
}

ensure_container() {
  local name="$1" label="$2"
  shift 2
  if container_exists "$name" && ! container_is_ours "$name" "$label"; then
    echo "==> Replacing $name (not created by this script)"
    docker rm -f "$name" >/dev/null
  fi
  if ! container_exists "$name"; then
    echo "==> Creating $name (kept between commands)"
    MSYS_NO_PATHCONV=1 docker create --name "$name" --label "$label=1" "$@" >/dev/null
  fi
  # Already running is fine: this is "make sure it is up", not "start it".
  docker start "$name" >/dev/null 2>&1 || true
}

# Mirror the working tree into <container>:<dest>. The file list comes from git
# (pack_repo_into: tracked plus untracked-not-ignored, minus tracked files
# deleted in the tree), staged inside the container and copied over, then
# whatever the tree no longer has is removed — so an edit, a new file, a rename
# and a deletion each land with one command, and a file the tree no longer has
# cannot linger in the container and keep compiling. node_modules, dist, build
# and target are never pruned: they belong to the container, and rebuilding
# them per command is exactly what a long-lived container exists to avoid.
#
# It is all shell and coreutils, with no tool the container has to have: the
# images this runs in are the repo's own, and one of them carries no rsync.
# (A file name with a newline in it would confuse the prune; the repo has
# none, and the cost would be a stale file, never a lost one.)
sync_tree() {
  local container="$1" dest="$2"
  echo "==> Syncing the working tree into $container"
  dexec "$container" sh -c 'rm -rf /tmp/codedeck-tree && mkdir -p /tmp/codedeck-tree'
  pack_repo_into "$container" /tmp/codedeck-tree
  dexec "$container" sh -c '
    set -e
    dest="$1"
    mkdir -p "$dest"
    cd /tmp/codedeck-tree
    find . -type f | sed "s|^\./||" | LC_ALL=C sort > /tmp/codedeck-want
    cp -a . "$dest"/
    cd "$dest"
    find . \( -name node_modules -o -name dist -o -name build -o -name target \) -prune -o -type f -print \
      | sed "s|^\./||" | LC_ALL=C sort > /tmp/codedeck-have
    comm -13 /tmp/codedeck-want /tmp/codedeck-have | while IFS= read -r gone; do rm -f -- "$gone"; done
    rm -rf /tmp/codedeck-tree /tmp/codedeck-want /tmp/codedeck-have
  ' sh "$dest"
}

# --- Workspace checks, in throwaway containers — nothing needs to be
# installed on the host.
#
# TypeScript (the agent host): a Node image with git and the pnpm pinned by
# package.json's packageManager; downloaded packages persist in the
# codedeck-pnpm-store volume, so `pnpm install` only fetches what the lockfile
# changed. Only the pnpm workspace is copied.
#
# Rust (every crate): the stock Rust image with clippy; the cargo registry
# and target dir live in named volumes, so a rerun only recompiles what
# changed. Only the cargo workspace is copied. ---

# The one Node image the checks and the dev container share (scripts/docker/
# node.Dockerfile), so a dependency is downloaded once into one store volume.
ensure_node_image() {
  local pnpm_version
  pnpm_version="$(sed -n 's/.*"packageManager": *"pnpm@\([^"]*\)".*/\1/p' package.json)"
  ensure_tool_image codedeck-node "$TOOL_IMAGE_DIR/node.Dockerfile" --build-arg "PNPM_VERSION=$pnpm_version"
}

check_typescript() {
  local name="codedeck-check-$$"
  ensure_node_image
  start_throwaway "$name" codedeck-node -v codedeck-pnpm-store:/pnpm-store

  pack_repo_into "$name" /app package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json packages
  echo "==> Installing dependencies"
  dexec -w /app "$name" pnpm install --frozen-lockfile
  case "$1" in
    typecheck) dexec -w /app "$name" pnpm -r --no-bail run typecheck ;;
    test) dexec -w /app "$name" pnpm -r --no-bail run test ;;
    check)
      dexec -w /app "$name" pnpm -r --no-bail run typecheck
      dexec -w /app "$name" pnpm -r --no-bail run test
      ;;
  esac
}

check_rust() {
  local name="codedeck-check-rust-$$"
  ensure_tool_image codedeck-check-rust "$TOOL_IMAGE_DIR/rust.Dockerfile"
  start_throwaway "$name" codedeck-check-rust \
    -v codedeck-cargo-registry:/usr/local/cargo/registry \
    -v codedeck-check-target:/repo/target

  # The pack list must carry every repository-root file the workspace reads
  # at compile time: bridge-runtime's tests include_str! config.example.json.
  pack_repo_into "$name" /repo crates Cargo.toml Cargo.lock config.example.json
  case "$1" in
    typecheck) dexec -w /repo "$name" cargo clippy --locked --workspace --all-targets -- -D warnings ;;
    test) dexec -w /repo "$name" cargo test --locked --workspace ;;
    check)
      dexec -w /repo "$name" cargo clippy --locked --workspace --all-targets -- -D warnings
      dexec -w /repo "$name" cargo test --locked --workspace
      ;;
  esac
}

# Same checks, on the local toolchain (no Docker). The Docker path packs
# only what each container needs; locally the whole repo is already here.
check_typescript_local() {
  # NODE_ENV inherited as production would make pnpm silently skip
  # devDependencies on install (and the toolchain this path runs —
  # typescript, vitest — IS devDependencies) and reach the tests, where the
  # Docker containers never set it. The containers run with it unset, so
  # unset it here too: same repo, same result either way.
  unset NODE_ENV
  echo "==> Installing dependencies (local toolchain)"
  pnpm install --frozen-lockfile
  case "$1" in
    typecheck) pnpm -r --no-bail run typecheck ;;
    test) pnpm -r --no-bail run test ;;
    check)
      pnpm -r --no-bail run typecheck
      pnpm -r --no-bail run test
      ;;
  esac
}

check_rust_local() {
  case "$1" in
    typecheck) cargo clippy --locked --workspace --all-targets -- -D warnings ;;
    test) cargo test --locked --workspace ;;
    check)
      cargo clippy --locked --workspace --all-targets -- -D warnings
      cargo test --locked --workspace
      ;;
  esac
}

# Each Docker check in a subshell: start_throwaway's EXIT trap removes that
# container. The local path needs no cleanup.
run_checks() {
  local state=0
  docker_state || state=$?
  case $state in
    0)
      (check_typescript "$1")
      (check_rust "$1")
      ;;
    2) fail_docker_down ;;
    *)
      ensure_toolchain node rust
      check_typescript_local "$1"
      check_rust_local "$1"
      ;;
  esac
}

# --- The dev container: what the throwaway checks are too slow for. ---
#
# The checks above answer "is this green?" in a container thrown away with the
# answer. Everything between — editing a driver, running one test file, driving
# a live agent, poking at a crate — wants the opposite: one container that
# keeps its node_modules and its store, with the working tree kept in step
# with the host. `./codedeck dev` is that container, and it is the difference
# between a two-second test run and a two-minute one.
DEV_IMAGE=codedeck-node
DEV_CONTAINER=codedeck-dev
DEV_ROOT=/repo
# Whether the container's install is current. The stamp lives outside the
# synced tree, which the mirror would otherwise delete.
DEV_LOCK_STAMP=/root/.codedeck-dev-lock

ensure_dev_container() {
  ensure_node_image
  ensure_container "$DEV_CONTAINER" codedeck.dev \
    -v codedeck-pnpm-store:/pnpm-store \
    -v codedeck-agents:/agents \
    "$DEV_IMAGE" sleep infinity
}

ensure_dev_deps() {
  local want have
  want="$(git hash-object pnpm-lock.yaml)"
  have="$(dexec "$DEV_CONTAINER" cat "$DEV_LOCK_STAMP" 2>/dev/null || true)"
  [ "$want" = "$have" ] && return 0
  echo "==> Installing the workspace's Node dependencies"
  dexec -w "$DEV_ROOT" "$DEV_CONTAINER" pnpm install --frozen-lockfile
  dexec "$DEV_CONTAINER" sh -c "printf '%s' '$want' > $DEV_LOCK_STAMP"
}

# The same "install when the lockfile moved" rule for a host that has the tree
# itself (a Docker-less Linux host): the stamp goes in the toolchain directory,
# which is gitignored and only exists for that path.
ensure_local_deps() {
  local want have
  want="$(git hash-object pnpm-lock.yaml)"
  have="$(cat toolchain/.codedeck-dev-lock 2>/dev/null || true)"
  [ "$want" = "$have" ] && return 0
  echo "==> Installing the workspace's Node dependencies"
  # NODE_ENV=production would make pnpm skip devDependencies — which is where
  # everything this runs (typescript, vitest) lives.
  (unset NODE_ENV; pnpm install --frozen-lockfile)
  printf '%s' "$want" > toolchain/.codedeck-dev-lock
}

# One command in the dev container, with the tree in step first.
cmd_dev() {
  local reset=0 sync=1 only_sync=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --reset) reset=1; shift ;;
      --no-sync) sync=0; shift ;;
      --sync-only) only_sync=1; shift ;;
      --) shift; break ;;
      -*) echo "unknown option for dev: $1" >&2; exit 2 ;;
      *) break ;;
    esac
  done

  # What the command is, and where it runs — relative to the repo root, which
  # both engines then translate. `dev vitest …` is the loop's most-run
  # command: it belongs where vitest expects to be (the agent host's package),
  # and without an explicit run/watch word it runs once, rather than opening a
  # watch UI no session can answer.
  local workdir="" vitest=()
  if [ "${1:-}" = vitest ]; then
    shift
    vitest=(npx vitest)
    case " $* " in
      *" run "*|*" watch "*|*" --watch"*|*" -w "*) ;;
      *) vitest+=(run) ;;
    esac
    workdir="packages/agent-host"
  fi
  set -- ${vitest[@]+"${vitest[@]}"} "$@"

  local state=0
  docker_state || state=$?
  case $state in
    # Docker answers: the container path below is the one that runs. The
    # other two branches never return.
    0) ;;
    2) fail_docker_down ;;
    # No Docker: the same command runs in this tree, on the vendored
    # toolchain, with no container in the way at all.
    *)
      ensure_toolchain node
      ensure_local_deps
      cd "${workdir:-.}"
      if [ $# -eq 0 ]; then exec "${SHELL:-bash}"; fi
      exec "$@"
      ;;
  esac

  [ "$reset" = 1 ] && docker rm -f "$DEV_CONTAINER" >/dev/null 2>&1
  ensure_dev_container
  if [ "$sync" = 1 ]; then
    sync_tree "$DEV_CONTAINER" "$DEV_ROOT"
    ensure_dev_deps
  fi
  [ "$only_sync" = 1 ] && return 0

  # A terminal (a person, or an agent with a pty) gets a pty; anything else
  # must not have one, or the command's output stops being a pipe.
  local tty=()
  if [ -t 0 ] && [ -t 1 ]; then tty=(-t); fi

  if [ $# -eq 0 ]; then
    MSYS_NO_PATHCONV=1 exec docker exec -i ${tty[@]+"${tty[@]}"} -w "$DEV_ROOT" "$DEV_CONTAINER" sh
  fi
  MSYS_NO_PATHCONV=1 exec docker exec -i ${tty[@]+"${tty[@]}"} \
    -w "$DEV_ROOT${workdir:+/$workdir}" "$DEV_CONTAINER" "$@"
}

# --- The Android container: the phone's tests, lint and snapshots. ---
#
# `apk` builds a throwaway container per run (build-apk.sh) and leans on the
# Gradle cache volume for speed. Iterating on the app is the same story as the
# agent host: one container, the tree synced in, warm caches — `android test`,
# `android lint`, `android paparazzi`, `android shell`.
#
# Gradle runs WITHOUT --offline. The platform DSL's `release(37)` resolves to
# `android-37.0`, which the toolchain image does not carry (it installs 37.2),
# so the first run downloads it through the SDK manager. Offline, that download
# cannot happen and the build stops with "Failed to find target with hash
# string 'android-37.0'" — which reads like a missing SDK when it is a flag.
ANDROID_IMAGE=codedeck-android-build
ANDROID_CONTAINER=codedeck-android-dev
ANDROID_ROOT=/workspace
ANDROID_PROJECT=apps/android

ensure_android_container() {
  if [ -z "$(docker images -q "$ANDROID_IMAGE" 2>/dev/null)" ]; then
    echo "==> Building the Android toolchain image (one-time; several GB, several minutes)"
    docker build -t "$ANDROID_IMAGE" -f "$ANDROID_PROJECT/docker/Dockerfile" "$ANDROID_PROJECT/docker"
  fi
  # The container is disposable; the Gradle user home, the cargo registry and
  # the cargo target dir are not, and live in named volumes.
  ensure_container "$ANDROID_CONTAINER" codedeck.android -m 6g \
    -v codedeck-android-cargo-registry:/opt/cargo/registry \
    -v codedeck-android-target:"$ANDROID_ROOT/target" \
    -v codedeck-android-gradle:/gradle-home \
    -e GRADLE_USER_HOME=/gradle-home \
    "$ANDROID_IMAGE" sleep infinity
}

# What a Gradle task left behind, in one line each: the counts from the JUnit
# XML, which classes failed, and what lint said. Read after both a pass and a
# failure — a failure is when it is worth most.
ANDROID_REPORT='
results=app/build/test-results/testDebugUnitTest
if [ -d "$results" ]; then
  count() { grep -h -o "$1=\"[0-9]*\"" "$results"/*.xml 2>/dev/null | awk -F"\"" "{n+=\$2} END{print n+0}"; }
  printf "==> tests: %s run, %s failed, %s errored, %s skipped\n" \
    "$(count tests)" "$(count failures)" "$(count errors)" "$(count skipped)"
  for f in "$results"/*.xml; do
    if grep -qE "failures=\"[1-9]|errors=\"[1-9]" "$f" 2>/dev/null; then
      printf "    failed: %s\n" "$(basename "$f" .xml | sed "s/^TEST-//")"
    fi
  done
fi
lint=app/build/reports/lint-results-debug.txt
if [ -f "$lint" ]; then
  printf "==> lint: %s\n" "$(grep -Eo "[0-9]+ errors?, [0-9]+ warnings?" "$lint" | tail -1)"
fi
exit 0
'

android_report() {
  # The same report either way: in the container at the project directory, or
  # in this one (the caller has already changed into apps/android).
  local container="${1:-}"
  if [ -n "$container" ]; then
    dexec -w "$ANDROID_ROOT/$ANDROID_PROJECT" "$container" sh -c "$ANDROID_REPORT"
  else
    sh -c "$ANDROID_REPORT"
  fi
}

# The Gradle task a subcommand means; anything else is passed through as it is,
# so `./codedeck android :app:dependencies` works like `gradle` would.
android_task() {
  case "$1" in
    test) echo testDebugUnitTest ;;
    lint) echo lintDebug ;;
    paparazzi) echo verifyPaparazziDebug ;;
    snapshot) echo recordPaparazziDebug ;;
    *) echo "$1" ;;
  esac
}

cmd_android() {
  # Options may sit anywhere: the rest of the line is the task and its own
  # arguments, passed through as they are.
  local sync=1 args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-sync) sync=0 ;;
      --) ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- ${args[@]+"${args[@]}"}
  # No subcommand means the common one.
  [ $# -eq 0 ] && set -- test
  local task
  task="$(android_task "$1")"
  shift

  local state=0
  docker_state || state=$?
  case $state in
    # Docker answers: the container path below is the one that runs. The
    # other two branches never return.
    0) ;;
    2) fail_docker_down ;;
    # No Docker: the Gradle wrapper runs against this tree directly. java and
    # the SDK come from wherever this host has them — a system install, or
    # the vendored toolchain — and only a host with neither installs the
    # toolchain's own (java comes with android). Asking for the components is
    # also the check: a toolchain directory that exists may hold only some of
    # them, and `android` alone would not find java in it.
    *)
      if ! command -v java >/dev/null 2>&1 || [ -z "${ANDROID_HOME:-}" ]; then
        ensure_toolchain android
      fi
      cd "$ANDROID_PROJECT"
      local code=0
      ./gradlew "$task" "$@" --console=plain || code=$?
      android_report
      # Recording writes the goldens straight into the tree here, which is
      # the whole of what the Docker path has to copy back.
      return "$code"
      ;;
  esac

  ensure_android_container
  [ "$sync" = 1 ] && sync_tree "$ANDROID_CONTAINER" "$ANDROID_ROOT"

  if [ "$task" = shell ]; then
    local tty=()
    if [ -t 0 ] && [ -t 1 ]; then tty=(-t); fi
    MSYS_NO_PATHCONV=1 exec docker exec -i ${tty[@]+"${tty[@]}"} -w "$ANDROID_ROOT/$ANDROID_PROJECT" \
      "$ANDROID_CONTAINER" sh
  fi

  local code=0
  dexec -w "$ANDROID_ROOT/$ANDROID_PROJECT" "$ANDROID_CONTAINER" \
    gradle "$task" "$@" --console=plain || code=$?

  android_report "$ANDROID_CONTAINER"

  # The goldens are recorded inside the container; they are only useful on the
  # host, where a person can look at each image before it is committed.
  if [ "$task" = recordPaparazziDebug ] && [ "$code" = 0 ]; then
    local goldens="$ANDROID_PROJECT/app/src/test/snapshots/images"
    mkdir -p "$goldens"
    MSYS_NO_PATHCONV=1 docker cp "$ANDROID_CONTAINER:$ANDROID_ROOT/$goldens/." "$goldens/"
    echo "==> Wrote $goldens — look at every image that changed before committing it"
  fi
  return "$code"
}

# --- One real agent, one real session, everything the host reports. ---
#
# Changing a driver means asking "what does the agent actually send, and what
# does the phone actually end up being shown?" — a question that used to cost
# a throwaway probe written, run and deleted every session. This is that probe,
# kept in the tree (packages/agent-host/tools/live-probe.mjs): it speaks the
# driver protocol to the built host exactly as the bridge does, so what it
# prints is the phone's own view — entries, turn states, context figures,
# errors — and it installs the agent at the version this build pins into the
# agents volume, so the first run of an agent is the only one that downloads.
LIVE_DEFAULT_TIMEOUT=300
LIVE_LOG=/tmp/codedeck-live.log

cmd_live() {
  local agent="${1:-}"
  case "$agent" in
    ''|-*)
      echo "usage: $0 live <agent> [--prompt TEXT]… [--mode MODE] [--model ID]" >&2
      echo "                     [--effort ID] [--cwd DIR] [--env K=V]… [--timeout SECONDS] [--no-sync]" >&2
      echo "agents: claude-code, opencode, deepseek-harness, fake" >&2
      exit 2
      ;;
  esac
  shift

  local sync=1 timeout="$LIVE_DEFAULT_TIMEOUT" probe=() pairs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-sync) sync=0; shift ;;
      --timeout) timeout="$2"; shift 2 ;;
      --env) pairs+=("$2"); shift 2 ;;
      *) probe+=("$1"); shift ;;
    esac
  done

  # A live session runs on a real account. Two agents cost nothing: the `fake`
  # test agent, and OpenCode's free Zen models. Everything else spends a
  # subscription or a balance, so a run that does not name a model says so
  # rather than quietly using whatever the agent defaults to.
  case " ${probe[*]-} " in
    *" --model "*|*" --models "*) ;;
    *)
      case "$agent" in
        fake) ;;
        opencode) echo "==> No --model: this runs OpenCode's own default, which is whatever it used last. A free one: --model opencode/cat-jam-free" ;;
        *) echo "==> No --model: this runs $agent's default, on your account. Free alternatives: opencode (free Zen models) or fake" ;;
      esac
      ;;
  esac

  local state=0
  docker_state || state=$?
  case $state in
    # Docker answers: the container path below is the one that runs. The
    # other two branches never return.
    0) ;;
    2) fail_docker_down ;;
    # No Docker: the host runs here, on the vendored Node.
    *)
      ensure_toolchain node
      ensure_local_deps
      echo "==> Building the agent host"
      pnpm --filter "@codedeck/agent-host" run build
      local workdir
      workdir="$(mktemp -d)"
      local code=0
      env ${pairs[@]+"${pairs[@]}"} CODEDECK_AGENT_HOST_DRIVERS="$agent" \
        timeout "${timeout}s" node packages/agent-host/tools/live-probe.mjs \
        --host packages/agent-host/dist/main.js --agent "$agent" --cwd "$workdir" \
        --timeout "$timeout" ${probe[@]+"${probe[@]}"} || code=$?
      live_report "$code" "$timeout" ""
      return "$code"
      ;;
  esac

  ensure_dev_container
  if [ "$sync" = 1 ]; then
    sync_tree "$DEV_CONTAINER" "$DEV_ROOT"
    ensure_dev_deps
  fi
  echo "==> Building the agent host"
  dexec -w "$DEV_ROOT/packages/agent-host" "$DEV_CONTAINER" pnpm run build

  # The session runs in a scratch directory, not in the tree: an agent given a
  # prompt is free to edit what it can see, and a probe is not a reason to let
  # it touch the repository.
  local live_cwd="/tmp/codedeck-live-$$"
  dexec "$DEV_CONTAINER" mkdir -p "$live_cwd"
  case " ${probe[*]-} " in
    *" --cwd "*) ;;
    *) probe+=(--cwd "$live_cwd") ;;
  esac

  local docker_env=()
  local pair
  for pair in ${pairs[@]+"${pairs[@]}"}; do docker_env+=(-e "$pair"); done

  local code=0
  dexec -i -w "$DEV_ROOT/packages/agent-host" \
    -e CODEDECK_AGENT_HOST_DRIVERS="$agent" \
    -e CODEDECK_AGENT_CACHE=/agents \
    ${docker_env[@]+"${docker_env[@]}"} \
    "$DEV_CONTAINER" timeout "${timeout}s" node tools/live-probe.mjs \
    --host dist/main.js --agent "$agent" --timeout "$timeout" --log "$LIVE_LOG" \
    ${probe[@]+"${probe[@]}"} || code=$?

  # The log outlives the container's /tmp, and is what to read after a run
  # that was killed or timed out. It lands under dist/ (gitignored, and the
  # repo's own place for what is not committed): a relative host path is what
  # `docker cp` needs here — with MSYS path conversion off for the container
  # side, an absolute one would be read as a Windows path.
  local host_log="dist/live-$agent.log"
  mkdir -p dist
  MSYS_NO_PATHCONV=1 docker cp "$DEV_CONTAINER:$LIVE_LOG" "$host_log" >/dev/null 2>&1 || true
  live_report "$code" "$timeout" "$host_log"
  return "$code"
}

live_report() {
  local code="$1" timeout="$2" log="$3"
  if [ -n "$log" ]; then echo "==> log: $log"; fi
  case "$code" in
    0) ;;
    124) echo "==> the probe was still running after ${timeout}s and was stopped" >&2 ;;
    *) echo "==> the probe reported a failure (exit $code)" >&2 ;;
  esac
}

# --- Putting the machine back. ---
#
# The containers this script keeps are disposable — everything expensive is in
# the volumes — but removing them is not something to do on a guess: a `clean`
# that cannot be answered (no terminal to prompt on: an agent, a CI job) does
# nothing and says how to mean it. The one-shot containers remove themselves,
# with their traps; these are the long-lived ones, and any a killed run left.
#
# Only containers this script made are touched. codedeck-bridge and
# codedeck-tor are the deployed service, not scratch: `bridge down` stops
# those. Volumes are never removed here — they hold the caches that make the
# next command fast — and the message says how to drop one.
OWNED_CONTAINER_PATTERN='^codedeck-(dev|android-dev|check|gen-android-bindings|android-build-run)(-|$)'

confirm() {
  if [ ! -t 0 ]; then
    echo "$1 [y/N] — no terminal to answer on: pass --yes to mean it" >&2
    return 1
  fi
  printf '%s [y/N] ' "$1" >&2
  local answer
  read -r answer || return 1
  case "$answer" in
    [yY] | [yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_clean() {
  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes | -y) assume_yes=1; shift ;;
      *) echo "usage: $0 clean [--yes]" >&2; exit 2 ;;
    esac
  done

  local state=0
  docker_state || state=$?
  case $state in
    2) fail_docker_down ;;
    1)
      echo "Docker is not installed: this script keeps no containers here." >&2
      return 0
      ;;
  esac

  local names=() other=() name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if printf '%s\n' "$name" | grep -Eq "$OWNED_CONTAINER_PATTERN"; then
      names+=("$name")
    elif printf '%s' "$name" | grep -q '^codedeck'; then
      other+=("$name")
    fi
  done <<<"$(docker ps -a --format '{{.Names}}')"

  if [ ${#other[@]} -gt 0 ]; then
    echo "==> Not this script's to remove (left alone):"
    printf '    %s\n' "${other[@]}"
  fi

  if [ ${#names[@]} -eq 0 ]; then
    echo "==> Nothing of this script's is running or left behind."
    return 0
  fi

  echo "==> Containers this script keeps (or a killed run left):"
  for name in "${names[@]}"; do
    printf '    %-26s %s\n' "$name" "$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo '?')"
  done
  echo "    They hold no state worth keeping — the caches live in the volumes,"
  echo "    which are NOT removed here. To drop one too: docker volume rm <name>"

  if [ "$assume_yes" != 1 ] && ! confirm "Remove these ${#names[@]} containers?"; then
    echo "==> Nothing removed."
    return 0
  fi
  docker rm -f "${names[@]}" >/dev/null
  echo "==> Removed ${#names[@]} containers. The next command recreates what it needs."
}

# --- What exists right now, in one command. ---
#
# A session should not have to ask Docker five questions to learn what it may
# run: this answers them in one call. Read-only, and it reports what is
# missing rather than failing on it — that is the point of it.
cmd_doctor() {
  echo "host"
  printf '  %-14s %s\n' "repo" "$(pwd)"
  printf '  %-14s %s\n' "os" "$(uname -s)"
  printf '  %-14s %s\n' "toolchain" "$([ -f toolchain/env.sh ] && echo 'present (./toolchain, for Docker-less Linux)' || echo 'absent')"

  local state=0
  docker_state || state=$?
  case $state in
    0) printf '  %-14s %s\n' "docker" "running" ;;
    1) printf '  %-14s %s\n' "docker" "not installed — check/test/typecheck/apk/dev/android/gen-android-bindings run locally; bridge and tor cannot"
       return 0 ;;
    2) printf '  %-14s %s\n' "docker" "installed, but its daemon is not answering — start it"
       return 0 ;;
  esac

  local tag size
  echo
  echo "images (this script builds them; 'docker rmi <tag>' reclaims one)"
  for tag in codedeck-node codedeck-check-rust codedeck-android-build; do
    size="$(docker images --format '{{.Size}}, {{.CreatedSince}}' "$tag" 2>/dev/null | head -1)"
    printf '  %-24s %s\n' "$tag" "${size:-not built}"
  done

  echo
  echo "volumes (the caches; 'docker volume rm <name>' resets one)"
  local volumes
  volumes="$(docker volume ls --filter name=codedeck --format '{{.Name}}')"
  if [ -n "$volumes" ]; then printf '%s\n' "$volumes" | sed 's/^/  /'; else echo "  none"; fi

  echo
  echo "containers"
  local containers
  containers="$(docker ps -a --filter name=codedeck --format '  {{.Names}}: {{.Status}}')"
  if [ -n "$containers" ]; then printf '%s\n' "$containers"; else echo "  none"; fi

  # What the two long-lived containers are good for right now. Only read while
  # they are running: a fact from a stopped container is no fact.
  if container_running "$DEV_CONTAINER"; then
    echo
    echo "$DEV_CONTAINER (./codedeck dev)"
    printf '  %-14s %s\n' "node" "$(dexec "$DEV_CONTAINER" node --version 2>/dev/null || echo '—')"
    printf '  %-14s %s\n' "pnpm" "$(dexec "$DEV_CONTAINER" pnpm --version 2>/dev/null || echo '—')"
    local lock have
    lock="$(git hash-object pnpm-lock.yaml)"
    have="$(dexec "$DEV_CONTAINER" cat "$DEV_LOCK_STAMP" 2>/dev/null || true)"
    if ! dexec "$DEV_CONTAINER" test -d "$DEV_ROOT/node_modules" 2>/dev/null; then
      printf '  %-14s %s\n' "node_modules" "not installed yet — the next 'dev' installs them"
    elif [ "$lock" = "$have" ]; then
      printf '  %-14s %s\n' "node_modules" "installed, current with pnpm-lock.yaml"
    else
      printf '  %-14s %s\n' "node_modules" "installed, but pnpm-lock.yaml moved on — the next 'dev' re-installs"
    fi
    local agents
    agents="$(dexec "$DEV_CONTAINER" sh -c 'ls /agents 2>/dev/null | grep -v "^\." | tr "\n" " "' 2>/dev/null || true)"
    printf '  %-14s %s\n' "agents" "${agents:-none installed (./codedeck live installs what it needs)}"
  fi

  if container_running "$ANDROID_CONTAINER"; then
    echo
    echo "$ANDROID_CONTAINER (./codedeck android)"
    printf '  %-14s %s\n' "sdk" "$(dexec "$ANDROID_CONTAINER" sh -c 'ls /opt/android-sdk/platforms 2>/dev/null | tr "\n" " "' 2>/dev/null || echo '—')"
    printf '  %-14s %s\n' "ndk" "$(dexec "$ANDROID_CONTAINER" sh -c 'ls /opt/android-sdk/ndk 2>/dev/null | tr "\n" " "' 2>/dev/null || echo '—')"
  fi
}


# --- Regenerate apps/android/app/src/main/java/uniffi/** from Rust (see
# crates/client-ffi/src/lib.rs's own doc comment — the Kotlin binding
# surface is a build artifact of `uniffi-bindgen`'s library-mode generation,
# never hand-edited). Builds the cdylib for the HOST target (the generated
# Kotlin source is architecture-independent — it only reads the crate's
# embedded UniFFI metadata, not the target triple), runs the bindgen binary,
# copies the output back. Does NOT cross-compile the actual .so for an
# Android ABI — that's a separate, NDK-dependent build step (apps/android's
# own Gradle Rust task, once it exists), out of scope for a pure
# Kotlin-source regeneration command. ---
# The local (Docker-free) variant: same steps, output copied straight from a
# temp dir. The Docker variant below copies only the cargo workspace in; the
# cargo registry and target dir live in cached volumes.
gen_android_bindings_local() {
  local out dest
  out="$(mktemp -d)"
  dest="apps/android/app/src/main/java/uniffi"
  echo "==> Building crates/client-ffi (host target)"
  cargo build --locked -p client-ffi --lib
  echo "==> Running uniffi-bindgen (Kotlin, library mode)"
  cargo run --locked -p client-ffi --bin uniffi-bindgen -- \
    generate --library target/debug/libclient_ffi.so --language kotlin --no-format \
    --out-dir "$out"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -R "$out/uniffi/." "$dest"
  rm -rf "$out"
  echo "==> Wrote $dest/**"
}

cmd_gen_android_bindings() {
  local state=0
  docker_state || state=$?
  if [ "$state" -ne 0 ]; then
    [ "$state" -eq 2 ] && fail_docker_down
    ensure_toolchain rust
    gen_android_bindings_local
    return
  fi
  local name="codedeck-gen-android-bindings-$$"
  start_throwaway "$name" rust:1-bookworm \
    -v codedeck-cargo-registry:/usr/local/cargo/registry \
    -v codedeck-uniffi-target:/repo/target

  pack_repo_into "$name" /repo crates Cargo.toml Cargo.lock
  echo "==> Building crates/client-ffi (host target)"
  dexec -w /repo "$name" cargo build --locked -p client-ffi --lib
  echo "==> Running uniffi-bindgen (Kotlin, library mode)"
  dexec -w /repo "$name" cargo run --locked -p client-ffi --bin uniffi-bindgen -- \
    generate --library target/debug/libclient_ffi.so --language kotlin --no-format \
    --out-dir /tmp/uniffi-kotlin-out

  local dest="apps/android/app/src/main/java/uniffi"
  rm -rf "$dest"
  mkdir -p "$dest"
  docker cp "$name":/tmp/uniffi-kotlin-out/uniffi/. "$dest"
  echo "==> Wrote $dest/**"
}

case "${1:-help}" in
  bridge) shift; cmd_bridge "$@" ;;
  tor) shift; cmd_tor "$@" ;;
  apk) shift; cmd_apk "$@" ;;
  dev) shift; cmd_dev "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  live) shift; cmd_live "$@" ;;
  android) shift; cmd_android "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  check) run_checks check ;;
  typecheck) run_checks typecheck ;;
  test) run_checks test ;;
  gen-android-bindings) cmd_gen_android_bindings ;;
  help|-h|--help) usage ;;
  *)
    echo "unknown command: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
