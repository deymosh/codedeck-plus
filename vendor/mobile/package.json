{
  "name": "codedeck-next-mobile",
  "private": true,
  "version": "0.9.5",
  "description": "CodeDeck Next — Android app (Tauri v2 + React 19) for driving Claude Code sessions on your laptop or VPS over encrypted Nostr.",
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "lint": "pnpm -r --no-bail run lint",
    "build": "pnpm -r --no-bail run build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@anthropic-ai/sdk": "*"
      },
      "ignoreMissing": [
        "@anthropic-ai/sdk"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeroenOnNostr/codedeck-next-mobile.git"
  }
}
