<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (minSdk 26, so no legacy density buckets exist). The
     foreground is a single nodpi raster padded to keep the mark inside the
     66dp visible-content circle of the 108dp canvas; monochrome reuses it —
     the launcher tints its alpha shape for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
