<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores allowBackup="false" for device-to-device transfer, so
     every domain is excluded here too. Nothing this app stores survives a move
     to another device usefully: identity.bin is wrapped by an Android Keystore
     key that never leaves this device, and codedeck.db holds decrypted
     transcripts that must not be copied off it. A new device pairs afresh. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
