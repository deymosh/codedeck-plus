#!/usr/bin/env bash
set -euo pipefail

operation="${1:-}"
protocol=""
host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done

case "$operation" in
  get)
    # Do not offer a GitHub token to arbitrary Git hosts.
    if [ "$protocol" = "https" ] && [ "$host" = "github.com" ] && [ -r /run/secrets/github_token ]; then
      token=$(< /run/secrets/github_token)
      if [ -n "$token" ]; then
        printf 'username=x-access-token\npassword=%s\n' "$token"
      fi
    fi
    ;;
  store|erase)
    # Never persist credentials supplied through this runtime secret.
    ;;
esac
