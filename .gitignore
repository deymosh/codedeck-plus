# deps / build output
node_modules/
dist/
out/
*.tsbuildinfo

# never commit release artifacts (the old repos carried 2.4GB of these)
*.apk
*.aab
*.vsix
*.tgz

# Tauri / Rust / Android
apps/mobile/src-tauri/target/
# gen/android (the `tauri android init` project) IS committed — its own
# .gitignore excludes build outputs, .gradle, local.properties and keystores
# (same split the old repo used: sources in, app/build out). Other gen/
# artifacts (schemas) stay generated.
apps/mobile/src-tauri/gen/*
!apps/mobile/src-tauri/gen/android/
target/
.gradle/
local.properties

# Cloudflare
.wrangler/
.dev.vars

# secrets
.env
.env.*
!.env.example
*.key
*service-account*.json

# misc
.DS_Store
coverage/
# local editor config — the workspace one pins relays to primal-only, which
# silently narrows any bridge launched from that VSCode window to ONE relay.
.vscode/

# CDX-018 device batch: the full screenshot set is 20MB and stays local.
# Tracked: every uiautomator dump + the screenshots the results doc cites.
docs/evidence/cdx-018-device-batch/*.png
