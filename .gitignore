.env*
!.env.example

# Node / pnpm workspace
node_modules/
**/node_modules/
pnpm-debug.log*
.pnpm-store/

# Build outputs
packages/agent-host/dist/
packages/vscode-extension/dist/
# Copied in from the repository root by the extension's tools/package.mjs.
packages/vscode-extension/LICENSE
packages/vscode-extension/media/
*.vsix
**/target/
**/*.tsbuildinfo

# Built APKs, release archives and the check logs land here — never commit a
# built binary.
/dist/
# Cargo workspace build output
/target
/crates/**/target

# scripts/install-toolchain.sh's local Android SDK/NDK (Linux host builds,
# apps/android/scripts/build-apk-local.sh) — project-scoped on purpose, never
# a system path, so it never collides with another project's SDK/NDK version.
/toolchain/

# Editor/agent-local MCP server config: contains a token, never shared.
.mcp.json
