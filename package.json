{
  "name": "codedeck-docker",
  "private": true,
  "version": "0.1.0",
  "description": "Personal CodeDeck monorepo fork — unified bridge + mobile, Tor/SOCKS5 transport, NIP-42 relay auth for private/Haven relays.",
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "build": "pnpm --filter @codedeck/bridge... run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@anthropic-ai/sdk": "*"
      },
      "ignoreMissing": [
        "@anthropic-ai/sdk"
      ]
    }
  },
  "license": "MIT"
}
