{
  "name": "codedeck-plus",
  "private": true,
  "version": "0.12.0",
  "description": "CodeDeck+ — run coding agents on your machine and drive them from your phone over end-to-end-encrypted Nostr. This manifest holds the one TypeScript package left: the agent host.",
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "build": "pnpm -r --no-bail run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@anthropic-ai/sdk": "*"
      },
      "ignoreMissing": [
        "@anthropic-ai/sdk"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deymosh/codedeck-plus.git"
  }
}
